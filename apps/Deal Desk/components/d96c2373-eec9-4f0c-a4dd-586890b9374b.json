    "rawHtml": {
      "value": "<div style=\"height:100%;box-sizing:border-box;margin:0;font-family:inherit;background:var(--cc-appBackground-surface)\"><div style=\"background:var(--cc-surface1-surface);border:1px solid var(--cc-default-border);border-radius:12px;padding:8px 20px\"><div style=\"display:grid;grid-template-columns:160px 1fr 1fr;gap:16px;padding:12px 0;border-bottom:1px solid var(--cc-weak-border);font-size:14px\"><span style=\"font-weight:600;color:var(--cc-success-systemStatus)\">Up to 10%</span><span style=\"color:var(--cc-primary-text)\">Rep discretion, logged automatically</span><span style=\"color:var(--cc-placeholder-text)\">No approver</span></div><div style=\"display:grid;grid-template-columns:160px 1fr 1fr;gap:16px;padding:12px 0;border-bottom:1px solid var(--cc-weak-border);font-size:14px\"><span style=\"font-weight:600;color:var(--cc-warning-systemStatus)\">10% – 20%</span><span style=\"color:var(--cc-primary-text)\">Finance Controller approval in this app</span><span style=\"color:var(--cc-placeholder-text)\">Finance group</span></div><div style=\"display:grid;grid-template-columns:160px 1fr 1fr;gap:16px;padding:12px 0;font-size:14px\"><span style=\"font-weight:600;color:var(--cc-error-systemStatus)\">Above 20%</span><span style=\"color:var(--cc-primary-text)\">CRO and CFO joint approval, deal review call</span><span style=\"color:var(--cc-placeholder-text)\">Executive Leadership group</span></div></div></div>"
