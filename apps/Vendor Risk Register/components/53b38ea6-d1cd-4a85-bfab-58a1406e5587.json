  "properties": {
    "rawHtml": {
      "value": "<div style=\"height:100%;box-sizing:border-box;margin:0;font-family:inherit;background:var(--cc-appBackground-surface)\"><div style=\"background:var(--cc-surface1-surface);border:1px solid var(--cc-default-border);border-radius:12px;padding:8px 20px\"><div style=\"display:grid;grid-template-columns:160px 1fr 1fr;gap:16px;padding:12px 0;border-bottom:1px solid var(--cc-weak-border);font-size:14px\"><span style=\"font-weight:600;color:var(--cc-error-systemStatus)\">High risk</span><span style=\"color:var(--cc-primary-text)\">Annual review, current SOC 2 Type II or ISO 27001</span><span style=\"color:var(--cc-placeholder-text)\">DPA and sub-processor notice to customers</span></div><div style=\"display:grid;grid-template-columns:160px 1fr 1fr;gap:16px;padding:12px 0;border-bottom:1px solid var(--cc-weak-border);font-size:14px\"><span style=\"font-weight:600;color:var(--cc-warning-systemStatus)\">Medium risk</span><span style=\"color:var(--cc-primary-text)\">Review every 18 months, security questionnaire</span><span style=\"color:var(--cc-placeholder-text)\">Owner attests access is least-privilege</span></div><div style=\"display:grid;grid-template-columns:160px 1fr 1fr;gap:16px;padding:12px 0;font-size:14px\"><span style=\"font-weight:600;color:var(--cc-success-systemStatus)\">Low risk</span><span style=\"color:var(--cc-primary-text)\">Review every 24 months</span><span style=\"color:var(--cc-placeholder-text)\">No customer or employee data permitted</span></div></div></div>"
    },
